# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.

# ---- Gemini (optional: without a key the app runs rules-only) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ---- Security (required) ----
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later invalidates every password and login session.
PASSWORD_HASH_SECRET=
TOKEN_TTL_HOURS=72

# ---- Admin (loan officer) account, created on first start (required) ----
ADMIN_EMAIL=admin@loancheck.local
ADMIN_PASSWORD=
ADMIN_NAME=Loan Officer

# ---- External database (optional) ----
# e.g. Neon: postgresql+psycopg://user:pass@host/db?sslmode=require
# Leave empty to use the bundled Postgres container below.
DATABASE_URL=

# ---- Postgres (inside Docker) ----
POSTGRES_DB=loan_check
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Host ports ----
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5433

# ---- Frontend build ----
# /api = same origin through nginx (recommended). Set a full URL only if the
# backend is hosted elsewhere; then add the frontend origin to ALLOWED_ORIGINS.
VITE_BACKEND_URL=/api
# Where nginx forwards /api/* (Render: https://<your-backend>.onrender.com)
BACKEND_UPSTREAM=http://backend:8000
# ALLOWED_ORIGINS=https://loans.example.com

LOG_LEVEL=INFO
