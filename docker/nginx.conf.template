server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Uploads: the backend caps one application at 15 MB in total.
    client_max_body_size 20m;

    # API -> backend. BACKEND_UPSTREAM is filled in when the container starts
    # (http://backend:8000 in Docker Compose, the backend's https URL on Render).
    # The trailing slash strips the /api prefix: /api/auth/login -> /auth/login.
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM}/;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Screening makes several LLM calls (reading PDFs, retries, fallback
        # models), which can take several minutes. Keep this above the worst case
        # so a slow-but-successful request doesn't show up as a 504.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Hashed build assets can be cached for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: unknown paths fall back to index.html.
    location / {
        try_files $uri /index.html;
    }
}
